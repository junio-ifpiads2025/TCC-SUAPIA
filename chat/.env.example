WAHA_BASE_URL=http://localhost:3000
WAHA_API_KEY=

# --- MENSAGERIA ---
# Providers habilitados, separados por vírgula (waha, telegram)
MESSAGING_PROVIDERS=waha
TELEGRAM_BOT_TOKEN=
# Segredo aleatório (A-Z a-z 0-9 _ -) validado no header X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=
OPENAI_API_KEY=
PGVECTOR_CONNECTION_STRING=postgresql+psycopg://admin:adminpassword@postgres_vector:5432/vetordatabase
PGVECTOR_COLLECTION=manuais_suap_ifpi

# --- NOVAS VARIÁVEIS DE CONTROLE DE ACESSO ---
# Mude para "True" para o bot responder a qualquer pessoa
RESPONDER_QUALQUER_NUMERO=False

MODELO_LLM=gpt-4o-mini
MODELO_EMBEDDING=text-embedding-3-small

# --- IDENTIDADE DO AGENTE ---
AGENT_NAME=SUAP-IA
AGENT_VERSION=1.0.0


TEMPERATURE=0.3

# --- SELEÇÃO DO PIPELINE ---
USE_AGENT=false

# --- AGENTE REACT ---
MODELO_LLM_AVANCADO=gpt-4o

# --- AVALIAÇÃO RAGAS ---
MODELO_AVALIADOR_LLM=gpt-4o-mini
MODELO_AVALIADOR_EMBEDDING=text-embedding-3-small

# --- AUTENTICAÇÃO / SESSÃO ---
REDIS_PASSWORD=suapiaRedis2025
REDIS_URL=redis://:suapiaRedis2025@localhost:6379
APP_BASE_URL=http://localhost:8002
SESSION_TTL_SECONDS=28800
MAX_DAILY_MESSAGES=25

# --- BASE DE CONHECIMENTO (RAG editável; separada dos manuais) ---
KNOWLEDGE_COLLECTION=conhecimento_agente
KNOWLEDGE_CHUNK_SIZE=800
KNOWLEDGE_CHUNK_OVERLAP=150
KNOWLEDGE_TOP_K=4
KNOWLEDGE_MAX_CHARS=200000

# --- PAINEL ADMIN ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- HISTÓRICO DE CONVERSA ---
THREAD_HISTORY_PAIRS=3

# --- FILA DE MENSAGENS ---
QUEUE_TIMEOUT_MINUTES=5

# --- SUAP MCP ---
SUAP_BASE_URL=https://suap.ifpi.edu.br
SUAP_TOKEN=

# Máximo de iterações do loop do agente ReAct (padrão: 5)
AGENT_MAX_ITERATIONS=5
# --- PAINEL ADMIN ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Segredo longo e aleatório para assinar o cookie de sessão
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_SECONDS=28800
QUEUE_MAX_ATTEMPTS=2
QUEUE_CONSUMERS=1
ACCESS_LOG_STORE_CONTENT=False
ACCESS_LOG_RETENTION_DAYS=90
