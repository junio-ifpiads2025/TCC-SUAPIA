WAHA_BASE_URL=http://localhost:3000
WAHA_API_KEY=
OPENAI_API_KEY=
COHERE_API_KEY=
PGVECTOR_CONNECTION_STRING=postgresql+psycopg://admin:adminpassword@postgres_vector:5432/vetordatabase
PGVECTOR_COLLECTION=manuais_suap_ifpi

# --- NOVAS VARIÁVEIS DE CONTROLE DE ACESSO ---
# Mude para "True" para o bot responder a qualquer pessoa
RESPONDER_QUALQUER_NUMERO=False
# Lista de números liberados separados por vírgula (só funciona se a variável acima for False)
NUMEROS_PERMITIDOS=5586999999999@c.us, 5511888888888@c.us

MODELO_LLM=gpt-4o-mini
MODELO_EMBEDDING=text-embedding-3-small

# --- IDENTIDADE DO AGENTE ---
AGENT_NAME=SUAP-IA

SYSTEM_PROMPT="Você é a {AGENT_NAME}, assistente virtual especializada nos manuais do SUAP do IFPI. Sua missão é fornecer respostas precisas e organizadas baseadas
     EXCLUSIVAMENTE no CONTEXTO RECUPERADO fornecido.
   2
   3 DIRETRIZES DE RESPOSTA:
   4 1. SÍNTESE INTELIGENTE: Extraia e combine informações de diferentes partes do contexto para formar uma resposta completa. Se o contexto menciona um
     recurso e, em outro trecho, os passos para usá-lo, você DEVE unir essas informações.
   5 2. PROCEDIMENTOS: Sempre que a resposta envolver um passo a passo, utilize obrigatoriamente listas numeradas para facilitar a leitura.
   6 3. OBJETIVIDADE: Seja direto e evite repetir o texto dos manuais na íntegra. Resuma o que for relevante para a dúvida do usuário.
   7 4. INTEGRIDADE: Não utilize conhecimentos externos. Se a informação realmente não constar nos trechos fornecidos, diga exatamente: 'Não encontrei
     essa informação nos manuais do SUAP disponíveis.'
   8 5. RESPOSTA PARCIAL: Se o contexto permitir responder apenas parte da pergunta, forneça as informações encontradas e indique o que não foi
     localizado.
   9 6. TOM DE VOZ: Mantenha um tom profissional, cordial e em Português (Brasil)."

TEMPERATURE=0.3

# --- SELEÇÃO DO PIPELINE ---
# USE_AGENT tem prioridade sobre USE_CRAG e USE_ADVANCED_RAG
USE_AGENT=false
USE_ADVANCED_RAG=false
USE_CRAG=false

# --- ADVANCED RAG / CRAG ---
MODELO_LLM_RAPIDO=gpt-4o-mini
MODELO_LLM_AVANCADO=gpt-4o
RERANKER_MODEL=rerank-multilingual-v3.0
RETRIEVAL_TOP_K=5
RERANKER_TOP_K=5
MULTI_QUERY_COUNT=3

# --- AVALIAÇÃO RAGAS ---
MODELO_AVALIADOR_LLM=gpt-4o-mini
MODELO_AVALIADOR_EMBEDDING=text-embedding-3-small

# --- PIPELINE CRAG ---
CRAG_SCORE_THRESHOLD=0.4
FALLBACK_MESSAGE=Desculpe, não encontrei informações suficientemente relevantes sobre isso nos manuais do SUAP.

# --- AUTENTICAÇÃO / SESSÃO ---
REDIS_PASSWORD=suapiaRedis2025
REDIS_URL=redis://:suapiaRedis2025@localhost:6379
APP_BASE_URL=http://localhost:8002
SESSION_TTL_SECONDS=28800
MAX_DAILY_MESSAGES=25

# --- PAINEL ADMIN ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- HISTÓRICO DE CONVERSA ---
THREAD_HISTORY_PAIRS=3

# --- FILA DE MENSAGENS ---
QUEUE_TIMEOUT_MINUTES=5

# --- SUAP MCP ---
SUAP_BASE_URL=https://suap.ifpi.edu.br
SUAP_TOKEN=

# Máximo de iterações do loop do agente ReAct (padrão: 5)
AGENT_MAX_ITERATIONS=5