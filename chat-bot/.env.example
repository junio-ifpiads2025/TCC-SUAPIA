WAHA_URL=http://localhost:3000/api/sendText
OPENAI_API_KEY=
PGVECTOR_CONNECTION_STRING=postgresql+psycopg://admin:adminpassword@postgres_vector:5432/vetordatabase
PGVECTOR_COLLECTION=manuais_suap_ifpi

# --- NOVAS VARIÁVEIS DE CONTROLE DE ACESSO ---
# Mude para "True" para o bot responder a qualquer pessoa
RESPONDER_QUALQUER_NUMERO=False
# Lista de números liberados separados por vírgula (só funciona se a variável acima for False)
NUMEROS_PERMITIDOS=5586999999999@c.us, 5511888888888@c.us

MODELO_LLM=gpt-3.5-turbo
MODELO_EMBEDDING=text-embedding-3-small

SYSTEM_PROMPT="Você é SUAP-IA, um assistente virtual especializado nos manuais oficiais do SUAP (Sistema Unificado de Administração Pública) do IFPI. Sua única fonte de informação é o CONTEXTO RECUPERADO DOS MANUAIS fornecido em cada mensagem. REGRAS: (1) Responda SOMENTE com base nas informações presentes no contexto fornecido. (2) Se a resposta não estiver no contexto, diga exatamente: 'Não encontrei essa informação nos manuais do SUAP disponíveis.' (3) NUNCA invente, suponha ou complete informações ausentes no contexto. (4) Sempre responda em Português (Brasil), de forma clara e objetiva. (5) Quando a resposta envolver um processo ou sequência de ações, use passos numerados. (6) Seja direto: sintetize o que for relevante, sem repetir o contexto na íntegra."

TEMPERATURE=0.1

# --- SELEÇÃO DO PIPELINE ---
USE_ADVANCED_RAG=false
USE_CRAG=false

# --- ADVANCED RAG / CRAG ---
MODELO_LLM_RAPIDO=gpt-4o-mini
MODELO_LLM_AVANCADO=gpt-4o
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RETRIEVAL_TOP_K=5
RERANKER_TOP_K=5
MULTI_QUERY_COUNT=3

# --- AVALIAÇÃO RAGAS ---
MODELO_AVALIADOR_LLM=gpt-4o-mini
MODELO_AVALIADOR_EMBEDDING=text-embedding-3-small

# --- PIPELINE CRAG ---
CRAG_SCORE_THRESHOLD=0.4
FALLBACK_MESSAGE=Desculpe, não encontrei informações suficientemente relevantes sobre isso nos manuais do SUAP.